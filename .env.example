# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
# Only variables that start with VITE_ reach the browser, and everything here
# ends up in the built JavaScript. Never put a secret in a VITE_ variable.

# Base URL of a running Expense-Tracker-API, without a trailing slash.
# Required in normal mode. The API must allow this app's origin:
#   CORS_ORIGINS=http://localhost:5173   (in the API's own .env)
VITE_API_URL=http://localhost:8000

# Set to true to run without a backend, on synthetic in-browser data.
# `npm run dev:demo` sets this for you through .env.demo.
VITE_DEMO=false

# Optional. ISO 4217 code used to format amounts. Display only: the API stores
# plain numbers and has no currency field. Default: INR.
# VITE_CURRENCY=INR
